{
  "$schema": "loop-control/v1",
  "title": "Goal",
  "type": "object",
  "required": [
    "goal_id",
    "title",
    "objective",
    "scope",
    "non_goals",
    "created_at",
    "status",
    "authority",
    "protected_resources",
    "completion_criteria"
  ],
  "additionalProperties": true,
  "properties": {
    "goal_id": { "type": "string", "pattern": "^[A-Z0-9_\\-]{3,64}$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "minLength": 20 },
    "updated_at": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "ACTIVE",
        "WAITING_HUMAN",
        "BLOCKED",
        "VALIDATING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "authority": { "type": "string", "minLength": 1 },
    "protected_resources": { "type": "array", "items": { "type": "string" } },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "revision": { "type": "integer", "minimum": 0 }
  }
}
